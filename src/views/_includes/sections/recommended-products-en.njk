{% from "components/product-card-en.njk" import productCardEn %}

{% if recommendedProducts %}
  <section class="gap-top-medium homepage-products product-anchor-section section-title-center">
    <h1>You may also find this useful</h1>

    <p>
      <br>
      <a href="/en-gb/products/" title="Shop"><strong>[See all]</strong></a>
    </p>

    <div class="product-scroller">
      <div class="product-scroller__track">

        {% for productCode in recommendedProducts %}
          {% set product = productsEn[productCode] %}

          {% if product %}
            {{ productCardEn(product) }}
          {% else %}
            {# Missing product in productsEn.json: {{ productCode }} #}
          {% endif %}
        {% endfor %}

      </div>
    </div>
  </section>
{% endif %}