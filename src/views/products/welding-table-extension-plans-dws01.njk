<script>
document.addEventListener('DOMContentLoaded', function () {
  const reviewsSection = document.querySelector('.product-reviews-section');
  if (!reviewsSection) return;

  const lightbox = reviewsSection.querySelector('#product-review-lightbox');
  const lightboxImage = reviewsSection.querySelector('#product-review-lightbox-image');

  if (!lightbox || !lightboxImage) return;

  reviewsSection.querySelectorAll('.product-opinion-gallery__item').forEach((button) => {
    button.addEventListener('click', function () {
      const fullImage = this.getAttribute('data-full');
      if (!fullImage) return;

      lightboxImage.src = fullImage;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  reviewsSection.querySelectorAll('[data-close-review-lightbox]').forEach((element) => {
    element.addEventListener('click', function () {
      lightbox.hidden = true;
      lightboxImage.src = '';
      document.body.style.overflow = '';
    });
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && !lightbox.hidden) {
      lightbox.hidden = true;
      lightboxImage.src = '';
      document.body.style.overflow = '';
    }
  });
});






/**
 * 1. GŁÓWNA FUNKCJA: Logika wyboru stołu, aktualizacja ceny i linku EasyCart
 */
function updateTableLink() {
  const config = document.getElementById('table-config').value;
  const addonCheckbox = document.getElementById('addon-checkbox');
  const isAddon = addonCheckbox ? addonCheckbox.checked : false;
  const buyBtn = document.getElementById('buy-table-btn');
  const label = document.getElementById('config-label');
  const priceDisplay = document.getElementById('main-price-value');

  // --- AKTUALIZACJA CENY NA STRONIE ---
  // Pozwalamy klientowi klikać checkbox w dowolnym momencie
  let basePrice = 89;
  let finalPrice = isAddon ? (basePrice + 0) : basePrice;

  if (priceDisplay) {
    priceDisplay.innerText = finalPrice;
  }

  // --- DEFINICJA LINKÓW EASYCART ---
  const soloLinks = {
    's16_10': 'https://cart.easy.tools/checkout/patryktrajder/plany-dxf-mobilne-przedluzenie-stolu-spawalniczego-2400x200-mm-dws01?lang=pl',
    's16_12': 'https://cart.easy.tools/checkout/patryktrajder/plany-dxf-mobilne-przedluzenie-stolu-spawalniczego-2400x200-mm-dws01-2?lang=pl',
    's16_15': 'https://cart.easy.tools/checkout/patryktrajder/plany-dxf-mobilne-przedluzenie-stolu-spawalniczego-2400x200-mm-dws01-3?lang=pl',
    's28_10': 'https://cart.easy.tools/checkout/patryktrajder/plany-dxf-mobilne-przedluzenie-stolu-spawalniczego-2400x200-mm-dws01-4?lang=pl',
    's28_12': 'https://cart.easy.tools/checkout/patryktrajder/plany-dxf-mobilne-przedluzenie-stolu-spawalniczego-2400x200-mm-dws01-5?lang=pl',
    's28_15': 'https://cart.easy.tools/checkout/patryktrajder/plany-dxf-mobilne-przedluzenie-stolu-spawalniczego-2400x200-mm-dws01-6?lang=pl',
  };

  const bundleLinks = {
    's28_15': '',
  };

  // --- LOGIKA PRZYCISKU (Tu jest blokada zakupu) ---
  if (config !== "none") {
    // Jeśli stół jest wybrany: odblokuj przycisk i przypisz odpowiedni link
    buyBtn.href = isAddon ? bundleLinks[config] : soloLinks[config];
    // buyBtn.classList.remove('disabled-btn');

    // Zdejmij ewentualne czerwone ostrzeżenie
    label.style.color = '#707070';
    label.style.fontWeight = '400';
    label.innerHTML = 'Wybierz konfigurację planów:';

    // Zgaś czerwoną ramkę
    const selectBox = document.getElementById('table-config');
    selectBox.style.borderColor = '#c5c4c4';
    selectBox.style.boxShadow = 'none';
  } else {
    // Jeśli stół NIE jest wybrany: przycisk zablokowany (nawet jeśli dodatek jest zaznaczony)
    buyBtn.href = 'javascript:void(0)';
    // buyBtn.classList.add('disabled-btn');
  }
}

/**
 * 2. FUNKCJA: Obsługa kliknięcia w zablokowany przycisk
 */
function handleTableDisabledClick() {
  const config = document.getElementById('table-config').value; // Teraz sprawdzamy wybór, a nie klasę
  const label = document.getElementById('config-label');
  const selectBox = document.getElementById('table-config');

  if (config === "none") {
    label.style.color = 'red';
    label.style.fontWeight = 'bold';
    label.style.textAlign = 'left';
    label.innerHTML = 'Wybierz konfigurację planów:';

    selectBox.style.borderColor = 'red';
    selectBox.style.boxShadow = '0 0 5px rgba(255, 0, 0, 0.4)';
    selectBox.focus({ preventScroll: true });
    selectBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    // Opcjonalnie zostawiamy focus, żeby po przewinięciu lista była "aktywna"
    setTimeout(() => selectBox.focus(), 500);
  }
}

/**
