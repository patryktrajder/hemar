<script>
/**
 * 1. MAIN FUNCTION: Table selection logic, price update, and EasyCart link
 */
function updateTableLink() {
  const config = document.getElementById('table-config').value;
  const addonCheckbox = document.getElementById('addon-checkbox');
  const isAddon = addonCheckbox ? addonCheckbox.checked : false;
  const buyBtn = document.getElementById('buy-table-btn');
  const label = document.getElementById('config-label');
  const priceDisplay = document.getElementById('main-price-value');

  let basePrice = 21;
  let finalPrice = isAddon ? (basePrice + 0) : basePrice;

  if (priceDisplay) {
    priceDisplay.innerText = finalPrice;
  }

  const soloLinks = {
    's16_10': '',
    's16_12': 'https://cart.easy.tools/checkout/patryktrajder/dxf-plans-mobile-welding-table-extension-1200x200-mm-dws0203?lang=en',
    's16_15': 'https://cart.easy.tools/checkout/patryktrajder/dxf-plans-mobile-welding-table-extension-1200x200-mm-dws013?lang=en',
    's28_10': '',
    's28_12': 'https://cart.easy.tools/checkout/patryktrajder/dxfpdf-plans-mobile-welding-table-extension-1200x200-mm-dws0204-gotowy-projekt-przedluzenia-do-stolu?lang=pl',
    's28_15': 'https://cart.easy.tools/checkout/patryktrajder/dxf-plans-mobile-welding-table-extension-1200x200-mm-dws016?lang=en',
  };

  const bundleLinks = {
    's28_15': '',
  };

  if (config !== "none") {
    buyBtn.href = isAddon ? bundleLinks[config] : soloLinks[config];

    label.style.color = '#707070';
    label.style.fontWeight = '400';
    label.innerHTML = 'Select plan configuration:';

    const selectBox = document.getElementById('table-config');
    selectBox.style.borderColor = '#c5c4c4';
    selectBox.style.boxShadow = 'none';
  } else {
    buyBtn.href = 'javascript:void(0)';
  }
}

/**
 * 2. FUNCTION: Handles clicks on the disabled button
 */
function handleTableDisabledClick() {
  const config = document.getElementById('table-config').value;
  const label = document.getElementById('config-label');
  const selectBox = document.getElementById('table-config');

  if (config === "none") {
    label.style.color = 'red';
    label.style.fontWeight = 'bold';
    label.style.textAlign = 'left';
    label.innerHTML = 'Please select plan configuration:';

    selectBox.style.borderColor = 'red';
    selectBox.style.boxShadow = '0 0 5px rgba(255, 0, 0, 0.4)';
    selectBox.focus({ preventScroll: true });
    selectBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    setTimeout(() => selectBox.focus(), 500);
  }
}

/**
 * 3. YOUR FUNCTION: Copy email address
 */
function copyEmail(element) {
  navigator.clipboard.writeText('sklep@trajder.com').then(function() {
    const numberSpan = element.querySelector('.number');
    numberSpan.innerHTML = '<span style="color: #00a650;">Copied! ✓</span>';

    setTimeout(function() {
      numberSpan.innerHTML = 'sklep@trajder.com';
    }, 2000);
  });
}
</script>
