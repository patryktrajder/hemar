{% extends "templates/layout-de.njk" %}
{% set tab = "products" %}

{% block meta %}
    <link rel="canonical" href="https://patryktrajder.com/de/products/"/>
    <title>Produkte | Patryk Trajder</title>
{% endblock meta %}

{% block vectors %}
    {% include "vectors/arrow-right.sym" %}
    {% include "vectors/home.sym" %}
{% endblock %}

{% block body %}
    <main class="products-page-main">
        <nav class="breadcrumbs gap-top">
            <span>
                <a href="/de/" title="Startseite">
                    <svg class="home icon">
                        <use xlink:href="#icon-home"></use>
                    </svg>
                </a>

                <svg class="icon">
                    <use xlink:href="#icon-arrow-right"></use>
                </svg>
            </span>

            <a href="/de/products/">
                <b>Produkte</b>
            </a>
        </nav>

        <article id="diy-tools" class="gap-top preview-list" data-product-shop>

            {% from "components/product-card-de.njk" import productCardDe %}

            {#
              Verfügbare Typen:
              - projects = DXF/PDF-Pläne
              - diy      = DIY-Bausätze
              - ready    = Fertige Produkte
            #}
            {% set productListDe = [
                { code: "TN01", type: "diy" },
                { code: "dWT04", type: "projects" },
                { code: "dWT02", type: "projects" },
                { code: "dWT01", type: "projects" },
                { code: "dWT03", type: "projects" },
                { code: "dWT05", type: "projects" },
                { code: "dWTA01", type: "projects" },
                { code: "dWTA02", type: "projects" },
                { code: "dWS02", type: "projects" },
                { code: "dWS01", type: "projects" },
                { code: "dWTA03", type: "projects" }
            ] %}

            {#
              SHOP-TABS

              Das sind separate Klassen für die Shop-Seite.
              Wir verwenden nicht .product-section-nav von den Produktseiten,
              damit das Filtern im Shop nicht mit dem Scrollen auf Produktseiten kollidiert.
            #}
            <nav class="product-shop-tabs" aria-label="Produktkategorien">
                <button
                    type="button"
                    class="product-shop-tabs__button is-active"
                    data-product-tab="all"
                    aria-pressed="true"
                >
                    Alle
                </button>

                <button
                    type="button"
                    class="product-shop-tabs__button"
                    data-product-tab="projects"
                    aria-pressed="false"
                >
                    DXF/PDF-Pläne
                </button>

                <button
                    type="button"
                    class="product-shop-tabs__button"
                    data-product-tab="diy"
                    aria-pressed="false"
                >
                    DIY-Bausätze
                </button>

                <button
                    type="button"
                    class="product-shop-tabs__button"
                    data-product-tab="ready"
                    aria-pressed="false"
                >
                    Fertige Produkte
                </button>
            </nav>

            <p class="product-shop-empty" data-product-empty hidden>
                Produkte in dieser Kategorie werden bald verfügbar sein.
            </p>

            <div class="product-cards-container">
                {% for item in productListDe %}
                    {% set product = productsDe[item.code] %}

                    {% if product %}
                        <div class="product-shop-item" data-product-type="{{ item.type }}">
                            {{ productCardDe(product) }}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

        </article>
    </main>

    <script>
      /*
        EINFACHES JS FÜR SHOP-TABS

        - funktioniert nur innerhalb von [data-product-shop]
        - beeinflusst nicht die Abschnitts-Tabs auf Produktseiten
        - ändert nicht die URL
        - weist Kategorien nicht automatisch zu
      */
      (function () {
        var shop = document.querySelector("[data-product-shop]");

        if (!shop) {
          return;
        }

        var tabs = shop.querySelectorAll("[data-product-tab]");
        var items = shop.querySelectorAll("[data-product-type]");
        var emptyMessage = shop.querySelector("[data-product-empty]");

        if (!tabs.length || !items.length) {
          return;
        }

        function showTab(activeTab) {
          var visibleCount = 0;

          tabs.forEach(function (tab) {
            var tabName = tab.getAttribute("data-product-tab");
            var isActive = tabName === activeTab;

            tab.classList.toggle("is-active", isActive);
            tab.setAttribute("aria-pressed", isActive ? "true" : "false");
          });

          items.forEach(function (item) {
            var productType = item.getAttribute("data-product-type");
            var shouldShow = activeTab === "all" || productType === activeTab;

            item.hidden = !shouldShow;

            if (shouldShow) {
              visibleCount++;
            }
          });

          if (emptyMessage) {
            emptyMessage.hidden = visibleCount > 0;
          }
        }

        tabs.forEach(function (tab) {
          tab.addEventListener("click", function () {
            showTab(tab.getAttribute("data-product-tab"));
          });
        });

        showTab("all");
      })();
    </script>
{% endblock %}